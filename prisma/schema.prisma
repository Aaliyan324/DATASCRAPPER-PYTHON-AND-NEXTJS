datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  PENDING
  PARSING
  SCRAPING
  COMPLETED
  ERROR
  QUEUED
  FAILED
}

model SearchJob {
  id              String      @id @default(cuid())
  userId          String?     // Clerk user ID (null = anonymous / legacy)
  originalCommand String
  parsedQuery     String?     // JSON string of ParsedQuery / SearchPlan
  pythonJobId     String?     // Legacy: was Python scraper job ID
  status          JobStatus   @default(PENDING)
  totalResults    Int         @default(0)
  progress        Int         @default(0)
  currentStage    String?
  recordsFound    Int         @default(0)
  searchStatistics Json?     // JSON of SearchStatistics
  searchZones     Int?
  queriesExecuted Int?
  duplicatesRemoved Int?
  createdAt       DateTime    @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  results         JobResult[]

  @@index([userId])
}

model Business {
  id             String      @id @default(cuid())
  name           String
  category       String
  address        String?
  area           String?
  city           String?
  country        String?
  phone          String?
  email          String?
  website        String?
  rating         Float?
  reviewCount    Int?
  price          String?
  openingHours   String?
  description    String?
  source         String
  sourceUrl      String?
  latitude       Float?
  longitude      Float?
  placeId        String?     // Google Places API place ID
  dataCompleteness String?   // FULL, PARTIAL, NAME_ONLY
  googleMapsUrl  String?
  internationalPhone String?
  businessStatus String?
  additionalData Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  jobs           JobResult[]

  @@index([name])
  @@index([category])
  @@index([city])
  @@index([placeId])
}

model JobResult {
  id         String    @id @default(cuid())
  jobId      String
  businessId String
  job        SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([jobId, businessId])
  @@index([jobId])
  @@index([businessId])
}
